  {
    "id": "link-rewilding-2023",
    "name": "Attitudes to rewilding and land restoration",
    "type": "snapshot",
    "source": "Scottish Environment LINK",
    "pollster": "Survation",
    "topic": ["Nature", "Agriculture"],
    "sampleSize": "1,018",
    "date": "October 2023",
    "description": "Scottish public attitudes to rewilding, species reintroduction, and land and nature restoration.",
    "questions": [
      {
        "text": "To what extent would you support or oppose the reintroduction of beavers to more of Scotland's rivers and wetlands?",
        "options": [
          { "label": "NET: Support", "value": 72 },
          { "label": "NET: Oppose", "value": 16 },
          { "label": "Neither support nor oppose", "value": 8 },
          { "label": "Don't know", "value": 4 }
        ]
      },
      {
        "text": "To what extent would you support or oppose the reintroduction of wolves to Scotland's uplands?",
        "options": [
          { "label": "NET: Support", "value": 46 },
          { "label": "NET: Oppose", "value": 42 },
          { "label": "Neither support nor oppose", "value": 7 },
          { "label": "Don't know", "value": 5 }
        ]
      },
      {
        "text": "Scotland should set a legally binding target to restore 30% of land and sea for nature by 2030. To what extent do you support or oppose this target?",
        "options": [
          { "label": "NET: Support", "value": 76 },
          { "label": "NET: Oppose", "value": 10 },
          { "label": "Neither support nor oppose", "value": 8 },
          { "label": "Don't know", "value": 6 }
        ]
      },
      {
        "text": "How important, if at all, is it that the Scottish Government takes action to restore Scotland's nature within the next 5 years?",
        "options": [
          { "label": "NET: Important", "value": 83 },
          { "label": "NET: Unimportant", "value": 8 },
          { "label": "Neither important nor unimportant", "value": 6 },
          { "label": "Don't know", "value": 3 }
        ]
      },
      {
        "text": "Scotland's peatlands store more carbon than all forests in the UK. To what extent would you support or oppose the Scottish Government setting a target to restore all of Scotland's degraded peatlands by 2040?",
        "options": [
          { "label": "NET: Support", "value": 85 },
          { "label": "NET: Oppose", "value": 6 },
          { "label": "Neither support nor oppose", "value": 6 },
          { "label": "Don't know", "value": 3 }
        ]
      },
      {
        "text": "Many of Scotland's rivers and lochs are affected by pollution from farming runoff and sewage. To what extent do you support or oppose the Scottish Government introducing stricter regulations on water pollution, even if this increases costs for farmers and water companies?",
        "options": [
          { "label": "NET: Support", "value": 79 },
          { "label": "NET: Oppose", "value": 11 },
          { "label": "Neither support nor oppose", "value": 7 },
          { "label": "Don't know", "value": 3 }
        ]
      },
      {
        "text": "Which of the following statements is closest to your view on land ownership in Scotland?",
        "options": [
          { "label": "Land should be more widely owned, with stronger community rights to buy land", "value": 58 },
          { "label": "Land ownership patterns are broadly fine as they are", "value": 16 },
          { "label": "Private landowners should have fewer restrictions on how they manage their land", "value": 8 },
          { "label": "Don't know", "value": 18 }
        ]
      }
    ]
  },
